# ============================================================
# APK V2NOXA — contoh konfigurasi backend
# Salin menjadi .env lalu isi nilai sebenarnya.
# JANGAN commit file .env. Token hanya dibaca di server.
# ============================================================

# Port server (hosting biasanya memberi PORT otomatis)
PORT=3000

# Folder penyimpanan status job (boleh dibiarkan default ./data)
# DATA_DIR=./data

# ------------------------------------------------------------
# Kredensial build (WAJIB untuk membuat APK sungguhan)
# Buat fine-grained token dengan izin:
#   Contents  : Read and write
#   Actions   : Read and write
#   Metadata  : Read
# ------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Branch yang memuat .github/workflows/build-apk.yml dan android-template
# (kosongkan untuk memakai default branch repo)
GITHUB_BUILD_REF=

# Nama file workflow di dalam .github/workflows/
GITHUB_WORKFLOW_FILE=build-apk.yml

# ------------------------------------------------------------
# Keamanan & batas upload
# ------------------------------------------------------------

# Bila diisi, pengguna wajib memasukkan kode ini sebelum menekan BUAT APK
APP_ACCESS_CODE=

# Batas ukuran file (MB)
MAX_SITE_MB=20
MAX_LOGO_MB=2

# Maksimum build per IP per jam
BUILD_RATE_LIMIT_MAX=10

# Batas waktu build sebelum dianggap gagal (menit)
BUILD_TIMEOUT_MIN=30
