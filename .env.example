# ============================================================
# APK V2NOXA — contoh konfigurasi backend
# Salin menjadi .env lalu isi nilai sebenarnya.
# JANGAN commit file .env. Token hanya dibaca di server.
# ============================================================

# Port server (AppJet/hosting biasanya memberi PORT otomatis)
PORT=3000

# Folder penyimpanan status job (boleh dibiarkan default)
DATA_DIR=./data

# ------------------------------------------------------------
# GitHub (WAJIB untuk build APK sungguhan)
# ------------------------------------------------------------
# Fine-grained personal access token dengan izin:
#   - Actions      : Read and write
#   - Contents     : Read and write
# Token TIDAK PERNAH dikirim ke frontend.
GITHUB_TOKEN=

# Pemilik dan nama repo yang menyimpan workflow + template Android
GITHUB_OWNER=
GITHUB_REPO=

# Branch/tag yang memuat .github/workflows/build-apk.yml
# Kosongkan untuk memakai default branch repo.
GITHUB_BUILD_REF=

# Nama file workflow di dalam .github/workflows/
GITHUB_WORKFLOW_FILE=build-apk.yml

# ------------------------------------------------------------
# Opsional
# ------------------------------------------------------------
# Bila diisi, pengguna harus memasukkan kode akses ini sebelum build.
APP_ACCESS_CODE=

# Batas ukuran upload (MB)
MAX_SITE_MB=20
MAX_LOGO_MB=2

# Batas waktu menunggu build (menit)
BUILD_TIMEOUT_MIN=30
